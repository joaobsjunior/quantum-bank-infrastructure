# Local-only example values. Copy to .env and replace every secret before use;
# nothing here is safe for any shared or reachable environment.
BIND_ADDRESS=127.0.0.1

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEYCLOAK_TEST_CLIENT_ID=quantum-bank-test
KEYCLOAK_TEST_CLIENT_SECRET=change-me-local-only
KEYCLOAK_SMOKE_USERNAME=alice@quantumbank.local
KEYCLOAK_SMOKE_PASSWORD=change-me-local-only
KEYCLOAK_SMOKE_SUBJECT=00000000-0000-0000-0000-000000000001

GATEWAY_BOOTSTRAP_PORT=8080
GATEWAY_BANKING_PORT=8443
BACKEND_IMAGE=quantum-bank-backend:local
GATEWAY_IMAGE=quantum-bank-api-gateway:local
# TLS terminator (HAProxy + OpenSSL 3.5) shared by the gateway listeners and
# the Keycloak issuer: ML-DSA + X25519MLKEM768 for post-quantum peers, ECDSA
# P-256 compatibility identity for peers without ML-DSA in their TLS stack.
GATEWAY_TLS_IMAGE=quantum-bank-api-gateway-tls:local
PQC_OPENSSL_IMAGE=alpine/openssl:3.5.8

BACKEND_SERVER_KEY_STORE_PASSWORD=changeit
BACKEND_TRUST_STORE_PASSWORD=changeit
# gid that owns pki/local-ca/private on the host (`stat -c %g pki/local-ca/private`).
# The same group lets the HAProxy terminators (uid 99) read the runtime PEM bundles.
PKI_GID=0

BACKEND_CLIENT_IMAGE=quantum-bank-backend-client:local
BACKEND_CLIENT_PORT=8090
BACKEND_CLIENT_CLIENT_ID=quantum-bank-backend-client
BACKEND_CLIENT_CLIENT_SECRET=change-me-local-only
BACKEND_CLIENT_SCOPE=pix:write statements:read profile:read
BACKEND_CLIENT_KEY_STORE_PASSWORD=changeit
BACKEND_CLIENT_TRUST_STORE_PASSWORD=changeit
BACKEND_CLIENT_CONSOLE_USERNAME=operator
BACKEND_CLIENT_CONSOLE_PASSWORD=change-me-local-only
